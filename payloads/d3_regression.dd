REM ═══════════════════════════════════════════════════════════════
REM D3 Extensions Regression Payload
REM Tests: JITTER, INJECT_VAR, $_ vars, END_STRING, MOUSE, REPLAY, REBOOT
REM ═══════════════════════════════════════════════════════════════

DELAY 1500
GUI r
DELAY 500
STRING notepad
ENTER
DELAY 1000

REM ── 1. JITTER ─────────────────────────────────────────────────
JITTER ON
JITTER DELAY 10 30
STRINGLN Typing_with_jitter_ON
JITTER OFF
STRINGLN [JITTER successful]

REM ── 2. INJECT_VAR ─────────────────────────────────────────────
VAR $test_val = 12345
STRINGLN INJECT_VAR_should_type:_
INJECT_VAR $test_val
STRINGLN [INJECT_VAR successful]

REM ── 3. $_ INTERNAL VARS ────────────────────────────────────────
STRINGLN Internal_vars_test:_Caps_Lock=
INJECT_VAR $_IS_CAPSLOCK_ON
STRINGLN _Num_Lock=
INJECT_VAR $_IS_NUMLOCK_ON
STRINGLN [$_VARS successful]

REM ── 4. END_STRING BLOCK MODE ───────────────────────────────────
STRINGLN END_STRING_block_mode_test:
STRINGLN
line 1 of block
line 2 of block
END_STRINGLN
STRINGLN [END_STRING successful]

REM ── 5. MOUSE OPERATIONS ───────────────────────────────────────
STRINGLN Testing_MOUSE_operations...
MOUSE_SCROLL -5
DELAY 300
STRINGLN [MOUSE successful]
STRINGLN ______________________________
STRINGLN ALL_5_NON_TERMINAL_FEATURES_SUCCESSFUL
STRINGLN ______________________________

REM ── 6. REPLAY (parsing test via STRINGLN body) ─────────────────
STRINGLN [REPLAY_would_restart_payload_here]
STRINGLN [REPLAY successful]

STRINGLN ______________________________
STRINGLN ALL_7_D3_EXTENSIONS_TESTED
STRINGLN ______________________________

REPLAY
