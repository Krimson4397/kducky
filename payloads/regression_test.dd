REM ═══════════════════════════════════════════════════════════════
REM kducky Official Regression Payload
REM Version: 1.0
REM
REM Execution order is designed to maximize coverage before the
REM first expected failure.  Features are ordered by how much of
REM the pipeline they exercise:
REM
REM   1. Preprocessor         — text-level, no interpreter needed
REM   2. Variables/Expressions — pure interpreter state
REM   3. Control flow          — interpreter logic
REM   4. Functions             — interpreter logic + call stack
REM   5. Random/STRING         — interpreter + platform output
REM   6. Keyboard combos       — interpreter + HID interaction
REM   7. HOLD/RELEASE          — interpreter + HID state
REM   8. RESET                 — cleanup before layout
REM   9. Layout switching      — platform state
REM  10. Windows UI            — optional, with delays
REM  11. Parser-only features  — EXPECTED TO FAIL
REM
REM The payload is designed so that if execution stops at any
REM point, everything before that line has been exercised.
REM ═══════════════════════════════════════════════════════════════

REM ── SECTION 1: Preprocessor (text-level, always succeeds) ────
REM Ordered first because it runs before the lexer — no
REM interpreter support needed.

DEFINE #DELAY_VAL 100
DEFINE #STR Hello world

REM ── SECTION 2: Variables (interpreter state only) ────────────
REM Ordered second because they exercise the runtime variable
REM system with zero side effects.

VAR $counter = 0
VAR $max = 5
VAR $result = 0
$counter = 1
VAR $t = TRUE
VAR $f = FALSE

REM ── SECTION 3: Expressions (interpreter arithmetic) ──────────
REM Safe: pure computation, no I/O, just verifies the expression
REM evaluator and operator precedence.

VAR $calc = (1 + 2) * 3
$calc = $calc ^ 2
VAR $flags = $calc & 0xFF
VAR $shifted = 1 << 3

REM ── SECTION 4: Control Flow (interpreter logic) ─────────────
REM Safe: pure interpreter state changes.  Exercises the
REM IF/ELSE/WHILE/BREAK/CONTINUE engine.

IF ($counter == 1) THEN
  STRINGLN counter_is_one
ELSE IF ($counter == 2) THEN
  STRINGLN counter_is_two
ELSE
  STRINGLN other
END_IF

WHILE ($max > 0)
  $max = $max - 1
  IF ($max == 3) THEN
    CONTINUE
  END_IF
  IF ($max == 0) THEN
    BREAK
  END_IF
  STRINGLN loop_body
END_WHILE

REM ── SECTION 5: Functions (interpreter call stack) ───────────
REM Safe: pure interpreter state.  Exercises function
REM registration, call, local scope, and return value.

FUNCTION greet()
  STRINGLN hello_from_fn
END_FUNCTION
greet()

FUNCTION add()
  VAR $local = 0
  $local = 100
  RETURN 42
END_FUNCTION
VAR $fn_result = add()

REM ── SECTION 6: Random + String output (platform typing) ────
REM Safe: generates random keystrokes but sends them to the
REM active window.  No system-modifying keystrokes.

RANDOM_CHAR
RANDOM_LETTER
RANDOM_NUMBER
RANDOM_SPECIAL
RANDOM_LOWERCASE_LETTER
RANDOM_UPPERCASE_LETTER

REM DEFINE substitution tested here
DELAY #DELAY_VAL
STRINGLN #STR

REM ── SECTION 7: Keyboard combos (non-destructive) ────────────
REM Safe: these modifier+key combinations do NOT trigger system
REM functions on Windows.  ENTER and ESC are safe on any focused
REM window.  Arrow keys test multi-key combos without side effects.

CTRL ESC
ALT SHIFT TAB
GUI TAB
SHIFT ENTER

REM Test INJECT_MOD standalone
INJECT_MOD

REM ── SECTION 8: HOLD/RELEASE (modifier + action key) ─────────
REM Safe: holds SHIFT to capitalize a single letter, then
REM RELEASE.  Also holds SPACE briefly (no system function).
REM Holds SPACE as a key press, then releases after delay.
REM Release of SPACE after HOLD

INJECT_MOD
HOLD SHIFT
STRING a
INJECT_MOD
RELEASE SHIFT
HOLD SPACE
DELAY 50
RELEASE SPACE
RESET

REM ── SECTION 9: RESET and payload control ────────────────────
REM RESET from interpreter state, then test RestartPayloadStmt
REM and StopPayloadStmt.  These may raise PayloadSignal exceptions
REM — the DesktopPlatform mock records them but does not raise,
REM so they are safe here.

RESET
STRINGLN reset_complete

REM ── SECTION 10: Layout switching (platform state) ───────────
REM Safe: changes HID keyboard layout mapping.  No OS popup.
REM Returns to US after test.

DUCKY_LANG DE
STRING ae
DUCKY_LANG US

REM ── SECTION 11: DELAY commands (platform timing) ────────────
REM Safe: pure timing, no OS interaction.

DELAY 50
DEFAULTDELAY 30
DEFAULTCHARDELAY 5

REM ── SECTION 12: REPEAT + comments ───────────────────────────
REM Safe: pure interpreter logic + harmless STRINGLN.

STRINGLN repeat_me
REPEAT 2

REM ── SECTION 13: IdentifierStmt (extension mechanism) ────────
REM Safe: exercises extension dispatch.  Uses an identifier
REM that should raise InterpreterError confirming the path works.
REM Commented out to avoid stopping the payload here.
REM Uncomment to verify the error path:
REM my_extension_call

REM ── SECTION 14: Windows UI interactions ─────────────────────
REM These interact with the Windows UI and change focus.
REM Each is properly bounded by DELAY and recovery keystrokes.
REM Tested in order from least to most disruptive.
REM ═══════════════════════════════════════════════════════════════
REM IMPORTANT: This section should only be run on an unlocked
REM Windows desktop with no unsaved work.
REM ═══════════════════════════════════════════════════════════════

REM ── 14a: GUI r (Run dialog) ──────────────────────────────────
REM Opens Run dialog → ALT F4 closes it.
REM 500ms delay: Run dialog takes ~100-500ms to appear.
GUI r
DELAY 500
ALT F4
DELAY 200

REM ── 14b: CTRL SHIFT ESC (Task Manager) ──────────────────────
REM Opens Task Manager → ALT F4 closes it.
REM 500ms delay: Task Manager takes ~200-500ms to appear.
CTRL SHIFT ESC
DELAY 500
ALT F4
DELAY 200

REM ── 14c: CTRL ALT DEL (Secure Desktop) ──────────────────────
REM THIS IS THE MOST DISRUPTIVE COMMAND.
REM Opens Secure Desktop → ESC returns to desktop.
REM 1500ms delay: Secure Desktop transition is the slowest
REM OS operation (500-1500ms depending on hardware/drivers).
REM After ESC, add 500ms for transition back.
REM ⌄⌄⌄⌄ PAYLOAD MAY STOP HERE (if Windows is locked) ⌄⌄⌄⌄
CTRL ALT DEL
DELAY 1500
ESC
DELAY 500

REM ── Post-Windows recovery check ──────────────────────────────
REM After Windows UI interactions, verify HID still works.
STRINGLN windows_ui_done

REM ═══════════════════════════════════════════════════════════════
REM SECTION 15: Parser-only features (EXPECTED TO FAIL)
REM
REM These features PARSER supports but INTERPRETER does not.
REM Execution will stop at the first one.
REM
REM Once M18 implements these visitors, they will execute instead
REM of crashing.  At that point, move them above this section.
REM ═══════════════════════════════════════════════════════════════

REM ── First expected failure: LED_G → NotImplementedError ─────
REM ⌄⌄⌄⌄ EXECUTION STOPS HERE (no visit_LedStmt) ⌄⌄⌄⌄
LED_G

REM ── The following are unreachable until LED visitor exists: ──
REM ATTACKMODE HID STORAGE
REM SAVE_ATTACKMODE
REM RESTORE_ATTACKMODE
REM SAVE_HOST_KEYBOARD_LOCK_STATE
REM WAIT_FOR_CAPS_OFF
REM WAIT_FOR_NUM_ON
REM WAIT_FOR_SCROLL_CHANGE
REM RESTORE_HOST_KEYBOARD_LOCK_STATE
REM HIDE_PAYLOAD
REM RESTORE_PAYLOAD
REM WAIT_FOR_BUTTON_PRESS
REM DISABLE_BUTTON
REM ENABLE_BUTTON
REM BUTTON_DEF my_button
REM   STRINGLN pressed
REM END_BUTTON_DEF
