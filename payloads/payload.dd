REM ═══════════════════════════════════════════════════════════════
REM kducky Official Regression Payload
REM Version: 1.2 — Full Demo (opens Notepad via GUI r)
REM
REM This payload opens the Windows Run dialog (GUI r), launches
REM Notepad, then types the full DuckyScript 3 regression test
REM output into Notepad.
REM
REM Execution order builds from basic to advanced features.
REM The payload runs to completion and types "all_done".
REM
REM   1. Open Notepad (GUI r → "notepad" → ENTER)
REM   2. Preprocessor
REM   3. Variables
REM   4. Expressions
REM   5. Control flow (IF/ELSE/WHILE/BREAK/CONTINUE)
REM   6. Functions (definition, call, return value)
REM   7. Random + STRING output
REM   8. HOLD/RELEASE (SHIFT + SPACE only)
REM   9. RESET
REM  10. Layout switching (DUCKY_LANG)
REM  11. DELAY / DEFAULTDELAY / DEFAULTCHARDELAY
REM  12. REPEAT
REM  13. LED blink pattern
REM  14. Payload hide/restore
REM
REM Everything runs to completion and types "all_done" at the end.
REM ═══════════════════════════════════════════════════════════════

REM ── Open Notepad (GUI r) ─────────────────────────────────────
REM Wait for host to detect the HID keyboard

DELAY 1000
GUI r
DELAY 500
STRING notepad
ENTER
DELAY 1000

REM ── SECTION 1: Preprocessor (text-level, before lexer) ────────

DEFINE #DELAY_VAL 50
DEFINE #STR Hello world
DEFINE #TEXT safe_regression

REM ── SECTION 2: Variables (interpreter state) ──────────────────

VAR $counter = 0
VAR $max = 5
VAR $result = 0
$counter = 1
VAR $t = TRUE
VAR $f = FALSE
VAR $name = TRUE

REM ── SECTION 3: Expressions (arithmetic, bitwise, shift) ───────

VAR $calc = (1 + 2) * 3
$calc = $calc ^ 2
VAR $flags = $calc & 0xFF
VAR $shifted = 1 << 3
VAR $combined = $flags | $shifted

REM ── SECTION 4: Control Flow (IF/ELSE/WHILE/BREAK/CONTINUE) ────

IF ($counter == 1) THEN
  STRINGLN counter_is_one
ELSE IF ($counter == 2) THEN
  STRINGLN counter_is_two
ELSE
  STRINGLN other
END_IF

WHILE ($max > 0)
  $max = $max - 1
  IF ($max == 3) THEN
    CONTINUE
  END_IF
  IF ($max == 0) THEN
    BREAK
  END_IF
  STRINGLN loop_body
END_WHILE

REM ── SECTION 5: Functions (definition, call, return) ───────────

FUNCTION greet()
  STRINGLN hello_from_fn
END_FUNCTION
greet()

FUNCTION add()
  VAR $local = 0
  $local = 100
  RETURN 42
END_FUNCTION
VAR $fn_result = add()

REM ── SECTION 6: Random + STRING output (platform typing) ──────

RANDOM_CHAR
RANDOM_LETTER
RANDOM_NUMBER
RANDOM_SPECIAL
RANDOM_LOWERCASE_LETTER
RANDOM_UPPERCASE_LETTER

REM DEFINE substitution tested here
DELAY #DELAY_VAL
STRINGLN #STR
STRINGLN prefix_#TEXT

REM ── SECTION 7: HOLD/RELEASE (SHIFT for caps, SPACE) ──────────
REM Only SHIFT and SPACE — no CTRL, ALT, or GUI modifiers.

INJECT_MOD
HOLD SHIFT
STRING a
INJECT_MOD
RELEASE SHIFT

HOLD SPACE
DELAY 50
RELEASE SPACE

REM SHIFT ENTER types a new line (safe in any text editor)
SHIFT ENTER

REM INJECT_MOD standalone exercises parser path
INJECT_MOD

REM ── SECTION 8: RESET ─────────────────────────────────────────

RESET
STRINGLN reset_complete

REM ── SECTION 9: Layout switching (platform state) ─────────────

DUCKY_LANG DE
STRINGLN ae
DUCKY_LANG US
STRINGLN back_to_us

REM ── SECTION 10: DELAY / DEFAULTDELAY / DEFAULTCHARDELAY ─────

DELAY 50
DEFAULTDELAY 30
DEFAULTCHARDELAY 5
STRINGLN delay_test_done

REM ── SECTION 11: REPEAT ──────────────────────────────────────

STRINGLN repeat_me
REPEAT 2

REM ── SECTION 12: LED blink pattern ────────────────────────────

LED_G
DELAY 1000
LED_OFF
DELAY 500
LED_G
DELAY 1500
LED_OFF
DELAY 1000
LED_G
DELAY 200
LED_OFF
DELAY 200
LED_G
DELAY 200
LED_OFF
DELAY 200
HIDE_PAYLOAD
RESTORE_PAYLOAD
STRINGLN all_done
