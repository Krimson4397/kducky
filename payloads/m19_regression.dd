REM -----------------------------------------------------------------------
REM M19 Hardware Validation -- Comprehensive DuckyScript 3 Regression
REM -----------------------------------------------------------------------
REM Exercises every implemented feature.  Sections separated by various
// REM-style and //-style comments are both used throughout.
REM_BLOCK
REM_BLOCK block comments are used here too.
This entire block is commentary.
END_REM
REM
REM DESTRUCTIVE-OP NOTES (read before running on real hardware):
REM - REPLAY line at end is COMMENTED OUT (uncomment to test REPLAY)
REM - REBOOT line at end is COMMENTED OUT (uncomment to test REBOOT)
REM - To test REPLAY: uncomment REPLAY while REBOOT stays commented.
REM - To test REBOOT: uncomment REBOOT while REPLAY stays commented.
REM - Notepad is opened at start -- close it manually after payload runs.
REM
REM -----------------------------------------------------------------------

// -- SECTION 0: Open Notepad -------------------------------------------------
// Only safe way to see typed output.  No destructive windows hotkeys elsewhere.
DELAY 1500
GUI r
DELAY 500
STRING notepad
ENTER
DELAY 1500

// ── SECTION 1: DEFINE preprocessor ─────────────────────────────────────────
// These constants are substituted at compile-time by the preprocessor.
DEFINE #DELAY_VAL 30
DEFINE #STR hello
DEFINE #NUM 42
DEFINE #SCORE [DEFINE OK]

DELAY #DELAY_VAL
STRINGLN m19 regression payload starting...
STRINGLN using define #STR with number #NUM
STRINGLN #SCORE

// ── SECTION 2: Comments demo ───────────────────────────────────────────────
REM This is a REM comment line
// This is a // comment line
REM_BLOCK
This is a REM_BLOCK comment.
It spans multiple lines.
All of this is ignored by the lexer.
END_REM
STRINGLN [COMMENTS OK]

// ── SECTION 3: Variables and expressions ────────────────────────────────────
VAR $x
VAR $y = 1 + 2
VAR $z = 42
VAR $t = TRUE
VAR $f = FALSE

// Arithmetic: 1+2*3 → 7
$x = 1 + 2 * 3
STRINGLN var_x_=_1+2*3_=
INJECT_VAR $x

// Bitwise: 1 & 3 → 1, 1 | 2 → 3
$x = 1 & 3
STRINGLN 1_&_3_=
INJECT_VAR $x
$x = 1 | 2
STRINGLN 1_|_2_=
INJECT_VAR $x

// Shift: 1 << 3 → 8
$x = 1 << 3
STRINGLN 1_<<_3_=
INJECT_VAR $x

// Logical: 1 && 0 → 0, 0 || 1 → 1
$x = 1 && 0
STRINGLN 1_&&_0_=
INJECT_VAR $x
$x = 0 || 1
STRINGLN 0_||_1_=
INJECT_VAR $x

// Relational: 1 < 2 → 1, 3 == 3 → 1
$x = 1 < 2
STRINGLN 1_<_2_=
INJECT_VAR $x
$x = 3 == 3
STRINGLN 3_==_3_=
INJECT_VAR $x

// Unary: !1 → 0, -5 → -5
$x = !1
STRINGLN not_1_=
INJECT_VAR $x
$x = -5
STRINGLN neg_5_=
INJECT_VAR $x

// Exponentiation: 2 ^ 3 → 8
$x = 2 ^ 3
STRINGLN 2_^_3_=
INJECT_VAR $x

// Parentheses override: (1+2)*3 → 9
$x = (1 + 2) * 3
STRINGLN (1+2)*3_=
INJECT_VAR $x

STRINGLN [EXPRESSIONS OK]

// ── SECTION 4: IF/ELSE IF/ELSE ─────────────────────────────────────────────
VAR $val
$val = 42

// TRUE branch
IF $val == 42 THEN
  STRINGLN if_true_branch_ok
END_IF

// ELSE branch
IF $val == 0 THEN
  STRINGLN should_not_see_this
ELSE
  STRINGLN else_branch_ok
END_IF

// ELSE IF chain
IF $val == 0 THEN
  STRINGLN should_not_see
ELSE IF $val == 42 THEN
  STRINGLN else_if_branch_ok
ELSE
  STRINGLN should_not_see_either
END_IF

STRINGLN [IF_ELSE OK]

// ── SECTION 5: WHILE / BREAK / CONTINUE ────────────────────────────────────
// Simple counter loop
VAR $count
$count = 0
WHILE $count < 5
  STRINGLN count_=
  INJECT_VAR $count
  $count = $count + 1
END_WHILE
STRINGLN [WHILE OK]

// BREAK at count 3
$count = 0
WHILE $count < 10
  IF $count == 3 THEN
    BREAK
  END_IF
  STRINGLN break_test_=
  INJECT_VAR $count
  $count = $count + 1
END_WHILE
STRINGLN [BREAK OK]

// CONTINUE: skip even numbers (print only odds)
$count = 0
WHILE $count < 6
  $count = $count + 1
  VAR $even
  $even = $count % 2
  IF $even == 0 THEN
    CONTINUE
  END_IF
  STRINGLN continue_odd_=
  INJECT_VAR $count
END_WHILE
STRINGLN [CONTINUE OK]

// ── SECTION 6: FUNCTIONS ────────────────────────────────────────────────────
FUNCTION add_one()
  VAR $tmp
  $tmp = 1 + 1
  RETURN $tmp
END_FUNCTION

VAR $func_result
$func_result = add_one()
STRINGLN func_result_=
INJECT_VAR $func_result
STRINGLN [FUNCTIONS OK]

// ── SECTION 7: RANDOM_* ────────────────────────────────────────────────────
// Each RANDOM_* statement types one random character directly.
STRINGLN random_char:
RANDOM_CHAR
STRINGLN
STRINGLN random_lowercase:
RANDOM_LOWERCASE_LETTER
STRINGLN
STRINGLN random_uppercase:
RANDOM_UPPERCASE_LETTER
STRINGLN
STRINGLN random_letter:
RANDOM_LETTER
STRINGLN
STRINGLN random_number:
RANDOM_NUMBER
STRINGLN
STRINGLN random_special:
RANDOM_SPECIAL
STRINGLN
STRINGLN [RANDOM OK]

// ── SECTION 8: TRUE/FALSE in comparisons ────────────────────────────────────
IF TRUE THEN
  STRINGLN true_const_ok
END_IF
IF FALSE THEN
  STRINGLN should_not_see
ELSE
  STRINGLN false_const_ok
END_IF
STRINGLN [TRUE_FALSE OK]

// ── SECTION 9: STRING / STRINGLN ────────────────────────────────────────────
STRING basic_string_text
STRINGLN
STRINGLN stringln_with_newline
STRINGLN [STRING_STRNGLN OK]

// ── SECTION 10: END_STRING block mode ──────────────────────────────────────
STRINGLN
this is line 1 of the block
this is line 2 of the block
this is line 3 of the block
END_STRINGLN
STRINGLN [END_STRINGLN OK]

// Also test END_STRING (no newline variant)
STRING
this is block text without trailing newline
END_STRING
STRINGLN [END_STRING OK]

// ── SECTION 11: DELAY / DEFAULTDELAY / DEFAULTCHARDELAY / REPEAT ───────────
// DEFAULTDELAY: adds delay after every statement
DEFAULTDELAY 50

// DEFAULTCHARDELAY: adds delay between each character typed
DEFAULTCHARDELAY 10

STRINGLN delay_and_repeat_test
STRINGLN

// REPEAT: repeat the previous statement 3 times
STRINGLN repeat_this_line
REPEAT 3
STRINGLN [REPEAT OK]

// Reset DEFAULTDELAY back to 0 and DEFAULTCHARDELAY back to 0
DEFAULTDELAY 0
DEFAULTCHARDELAY 0

// ── SECTION 12: RESET ──────────────────────────────────────────────────────
// RESET releases all held keys and resets modifiers.
STRINGLN before_reset
RESET
STRINGLN after_reset
STRINGLN [RESET OK]

// ── SECTION 13: INJECT_MOD / HOLD / RELEASE ────────────────────────────────
// HOLD SHIFT + type 'a' → types uppercase A, then release SHIFT
INJECT_MOD
HOLD SHIFT
STRING a
RELEASE SHIFT
STRINGLN

// HOLD SPACE briefly then release
HOLD SPACE
DELAY 100
RELEASE SPACE
STRINGLN [HOLD_RELEASE OK]

// ── SECTION 14: DUCKY_LANG ─────────────────────────────────────────────────
// Switch to German layout then back to US
DUCKY_LANG DE
STRINGLN deutsche_zeichen_test
DUCKY_LANG US
STRINGLN [DUCKY_LANG OK]

// ── SECTION 15: SAVE/RESTORE HOST LOCK STATE ───────────────────────────────
SAVE_HOST_KEYBOARD_LOCK_STATE
STRINGLN lock_state_saved
RESTORE_HOST_KEYBOARD_LOCK_STATE
STRINGLN lock_state_restored
STRINGLN [LOCK_STATE OK]

// ── SECTION 16: HIDE_PAYLOAD / RESTORE_PAYLOAD ─────────────────────────────
// These are safe — they catch RuntimeError on desktop (no filesystem to hide).
HIDE_PAYLOAD
STRINGLN payload_hidden
RESTORE_PAYLOAD
STRINGLN payload_restored
STRINGLN [HIDE_RESTORE OK]

// ── SECTION 17: INJECT_VAR and $_ internal variables ───────────────────────
// DECLARE a variable and INJECT_VAR to type it
VAR $myvar
$myvar = 999
STRINGLN inject_var_value=
INJECT_VAR $myvar
STRINGLN

// $_ internal variables
STRINGLN capslock=
INJECT_VAR $_IS_CAPSLOCK_ON
STRINGLN
STRINGLN numlock=
INJECT_VAR $_IS_NUMLOCK_ON
STRINGLN
STRINGLN scrolllock=
INJECT_VAR $_IS_SCROLLLOCK_ON
STRINGLN
STRINGLN [INJECT_VAR_OK]

// ── SECTION 18: JITTER ─────────────────────────────────────────────────────
JITTER ON
JITTER DELAY 10 30
STRINGLN typing_with_jitter_enabled
JITTER OFF
STRINGLN [JITTER OK]

// ── SECTION 19: MOUSE operations ──────────────────────────────────────────
// MOUSE_MOVE: move right 50 pixels
MOUSE_MOVE 50 0
DELAY 200
// MOUSE_CLICK: left click at current position
MOUSE_CLICK LEFT
DELAY 200
// MOUSE_SCROLL: scroll up 5 notches (negative = up/away)
MOUSE_SCROLL -5
DELAY 200
STRINGLN [MOUSE OK]

// ── SECTION 20: LED operations ─────────────────────────────────────────────
LED_G
DELAY 200
LED_R
DELAY 200
LED_B
DELAY 200
LED_OFF
STRINGLN [LED OK]

// ── SECTION 21: SHIFT ENTER (newline in Notepad — safe modifier combo) ─────
STRINGLN shift_enter_test
SHIFT ENTER
STRINGLN still_on_same_paragraph
STRINGLN [SHIFT_ENTER OK]

// ── SECTION 22: Modifier-safe single-key press ─────────────────────────────
// Press ENTER, TAB, SPACE as standalone action keys
ENTER
STRINGLN after_enter
TAB
STRINGLN after_tab
STRINGLN [ACTION_KEYS OK]

// ── SECTION 23: DELAY with expression ──────────────────────────────────────
VAR $d = 100
DELAY $d
STRINGLN [DELAY_EXPR OK]

// ── SECTION 24: Assign variable from expression ────────────────────────────
VAR $a = 10
VAR $b = 20
$a = $a + $b
STRINGLN a_plus_b_=
INJECT_VAR $a
STRINGLN [ASSIGN OK]

// ── SECTION 25: Nested expressions ─────────────────────────────────────────
VAR $nested
$nested = (1 + 2) * (3 + 4) - 5 / 2
STRINGLN nested_expr_=
INJECT_VAR $nested
STRINGLN [NESTED_EXPR OK]

// ── SECTION 26: Bitwise expressions ────────────────────────────────────────
VAR $bw
$bw = 15 & 7
STRINGLN 15_&_7_=
INJECT_VAR $bw
$bw = 15 | 7
STRINGLN 15_|_7_=
INJECT_VAR $bw
$bw = 1 << 4
STRINGLN 1_<<_4_=
INJECT_VAR $bw
STRINGLN [BITWISE OK]

// ── SECTION 27: Modulo and power ───────────────────────────────────────────
VAR $modpow
$modpow = 10 % 3
STRINGLN 10_%_3_=
INJECT_VAR $modpow
$modpow = 2 ^ 4
STRINGLN 2_^_4_=
INJECT_VAR $modpow
STRINGLN [MOD_POWER OK]

// ── FINAL STATUS LINE ──────────────────────────────────────────────────────
STRINGLN
STRINGLN ========================================
STRINGLN all_regression_tests_passed
STRINGLN ========================================

// ═══════════════════════════════════════════════════════════════════════════
// DESTRUCTIVE OPERATIONS — COMMENTED OUT BY DEFAULT
// ═══════════════════════════════════════════════════════════════════════════
// To test REPLAY: uncomment the REPLAY line below, keep REBOOT commented.
// To test REBOOT: uncomment the REBOOT line below, keep REPLAY commented.

// REPLAY  — restarts current payload from beginning (caught by main.py)
// REPLAY

// REBOOT  — shuts down target computer (GUI r → shutdown /r /t 0)
// REBOOT
